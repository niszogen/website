---
import logoIconUrl from '../assets/logo.png?url';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/png" href={logoIconUrl} />
		<link rel="apple-touch-icon" href={logoIconUrl} />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
			referrerpolicy="no-referrer"
		/>
		<meta name="generator" content={Astro.generator} />

		<link rel="me" href="https://fedi.niszogen.com/@niszogen">
		<link rel="me" href="https://wetdry.world/@niszogen">

		<title>NISZOgen</title>
	</head>
	<body>
		<slot />
	</body>
</html>
